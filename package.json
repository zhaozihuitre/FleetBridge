{
  "name": "fleet-bridge",
  "version": "0.9.59",
  "private": true,
  "description": "Fleet Bridge: game-style command bridge for multiple Claude Code sessions and agents",
  "type": "module",
  "main": "desktop/main.cjs",
  "bin": {
    "fleet-bridge": "bin/fleet-bridge.cjs"
  },
  "files": [
    "bin/",
    "desktop/",
    "server/",
    "web/",
    "tools/update.mjs"
  ],
  "scripts": {
    "start": "node server/index.js",
    "app": "electron .",
    "demo": "node -e \"process.env.MONITOR_DEMO='1';process.env.MONITOR_PORT='8788';import('./server/index.js').then((m)=>m.start())\"",
    "probe": "node server/probe.js",
    "dist": "node tools/dist.mjs",
    "update": "node tools/update.mjs",
    "postinstall": "node -e \"try{require('electron')}catch(e){console.warn('Electron not ready: '+e.message)}\""
  },
  "build": {
    "appId": "local.claude-ops.monitor",
    "productName": "Fleet Bridge",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "desktop/**",
      "server/**",
      "web/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/{src,typings,test,tests,docs}/**",
      "!node_modules/**/{README,CHANGELOG,HISTORY}*"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US",
      "ja"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fleet Bridge 舰桥",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "artifactName": "FleetBridge-Setup-${version}.${ext}"
    },
    "asar": false
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "fleetShellApi": 1,
  "optionalDependencies": {
    "electron": "^45.1.0"
  }
}
